    "BalanceReconciliation": {
      "title": "BalanceReconciliation",
      "description": "Registro de conciliación de saldo entre libro y casa de apuestas",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "accountId": { "type": "string" },
        "accountLabel": { "type": "string" },
        "currency": { "type": "string" },
        "calculatedBalanceCents": { "type": "integer" },
        "observedBalanceCents": { "type": "integer" },
        "differenceCents": { "type": "integer" },
        "reason": { "type": "string" },
        "reconciliationDate": { "type": "string" },
        "adjustmentTransactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
