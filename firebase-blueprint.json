        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "holderId", "holderName", "periodLabel", "currency", "eligibleProfitCents", "appliedPct", "generatedCommissionCents", "paidAmountCents", "pendingAmountCents", "status", "createdAt", "updatedAt"]
    },
    "VerificationRequirement": {
      "title": "VerificationRequirement",
