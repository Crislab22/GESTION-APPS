        "periodLabel": { "type": "string" },
        "includedAccounts": { "type": "string" },
        "currency": { "type": "string" },
        "eligibleProfitCents": { "type": "integer" },
        "manualAdjustmentCents": { "type": "integer" },
        "adjustmentReason": { "type": "string" },
        "appliedPct": { "type": "number" },
        "generatedCommissionCents": { "type": "integer" },
        "paidAmountCents": { "type": "integer" },
        "pendingAmountCents": { "type": "integer" },
        "status": { "type": "string", "description": "PENDIENTE | PARCIAL | PAGADA" },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "receiptPath": { "type": "string" },
