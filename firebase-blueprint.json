        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "accountId", "accountLabel", "requirementType", "status", "requestDate", "priority", "createdAt", "updatedAt"]
    },
    "StatusHistoryRecord": {
      "title": "StatusHistoryRecord",
      "description": "Historial de restricciones, cambios de estado y auditoría",
