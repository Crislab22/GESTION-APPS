        "source": { "type": "string" },
        "rateDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fromCurrency", "toCurrency", "rate", "source", "rateDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Perfil y configuración del administrador autenticado"
    },
    "/users/{userId}/holders/{holderId}": {
      "schema": { "$ref": "#/entities/AccountHolder" },
      "description": "Titulares de cuentas administrados por el usuario"
    },
    "/users/{userId}/bookmakers/{bookmakerId}": {
      "schema": { "$ref": "#/entities/Bookmaker" },
      "description": "Catálogo maestro de casas de apuestas y propiedades por país"
    },
    "/users/{userId}/relations/{relationId}": {
      "schema": { "$ref": "#/entities/BookmakerRelation" },
      "description": "Casas gemelas y relaciones entre proveedores"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BettingAccount" },
      "description": "Cuentas individuales vinculadas a titulares y casas"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Billeteras o cajas centrales del administrador"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/FinancialTransaction" },
      "description": "Movimientos financieros auditables"
    },
    "/users/{userId}/commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/CommissionSettlement" },
      "description": "Liquidaciones y pagos de comisiones a titulares"
    },
    "/users/{userId}/requirements/{requirementId}": {
      "schema": { "$ref": "#/entities/VerificationRequirement" },
      "description": "Requisitos y verificaciones KYC por cuenta"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/StatusHistoryRecord" },
      "description": "Historial de cambios de estado y auditoría"
    },
    "/users/{userId}/attachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/AttachmentRecord" },
      "description": "Comprobantes y capturas de pantalla"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertReminder" },
      "description": "Alertas y recordatorios operativos"
    },
    "/users/{userId}/reconciliations/{reconciliationId}": {
      "schema": { "$ref": "#/entities/BalanceReconciliation" },
      "description": "Conciliaciones de saldo entre libro y operador"
    },
    "/users/{userId}/exchange_rates/{rateId}": {
      "schema": { "$ref": "#/entities/ExchangeRateRecord" },
      "description": "Tasas de cambio registradas con fuente y fecha"
    }
  }
}
