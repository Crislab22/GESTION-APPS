      "required": ["userId", "accountId", "accountLabel", "currency", "calculatedBalanceCents", "observedBalanceCents", "differenceCents", "reason", "reconciliationDate", "createdAt", "updatedAt"]
    },
    "ExchangeRateRecord": {
      "title": "ExchangeRateRecord",
      "description": "Tipo de cambio multimoneda con fuente y fecha",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fromCurrency": { "type": "string" },
        "toCurrency": { "type": "string" },
